rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validText(value) {
      return value is string && value.size() <= 120;
    }

    function validAddress(data) {
      return !('address' in data) || (
        data.address is map
        && data.address.keys().hasAll(['postalCode', 'street', 'number', 'complement', 'neighborhood', 'city', 'state'])
        && data.address.keys().hasOnly(['postalCode', 'street', 'number', 'complement', 'neighborhood', 'city', 'state'])
        && validText(data.address.postalCode)
        && validText(data.address.street)
        && validText(data.address.number)
        && validText(data.address.complement)
        && validText(data.address.neighborhood)
        && validText(data.address.city)
        && validText(data.address.state)
        && ((data.address.postalCode == '' && data.address.street == ''
          && data.address.number == '' && data.address.complement == ''
          && data.address.neighborhood == '' && data.address.city == '' && data.address.state == '')
          || (data.address.postalCode.matches('^[0-9]{8}$')
            && data.address.street.size() > 0 && data.address.number.size() > 0
            && data.address.neighborhood.size() > 0 && data.address.city.size() > 0
            && data.address.state.matches('^(AC|AL|AP|AM|BA|CE|DF|ES|GO|MA|MT|MS|MG|PA|PB|PR|PE|PI|RJ|RN|RS|RO|RR|SC|SP|SE|TO)$')))
      );
    }

    function validCoordinates(data) {
      return !('coordinates' in data) || data.coordinates == null || (
        data.coordinates is map
        && data.coordinates.keys().hasAll(['latitude', 'longitude'])
        && data.coordinates.keys().hasOnly(['latitude', 'longitude'])
        && data.coordinates.latitude is number
        && data.coordinates.longitude is number
        && data.coordinates.latitude >= -90 && data.coordinates.latitude <= 90
        && data.coordinates.longitude >= -180 && data.coordinates.longitude <= 180
      );
    }

    // Campos opcionais para manter compatibilidade com perfis antigos.
    // O formato de cada objeto será definido no fluxo de cadastro de livros.
    function validBookLists(data) {
      return (!('books' in data) || data.books is list)
        && (!('likedBooks' in data) || data.likedBooks is list);
    }

    function validProfile(data) {
      return validText(data.displayName) && data.displayName.size() > 0
        && data.whatsapp is string && data.whatsapp.matches('^\\+[1-9][0-9]{7,14}$')
        && validAddress(data) && validCoordinates(data) && validBookLists(data);
    }

    function validBook(data) {
      return data.keys().hasOnly([
          'ownerId', 'owner', 'title', 'author', 'images', 'thumbnail',
          'category', 'type', 'available', 'bookCondition',
          'bookConditionNote', 'tradeWithBookId', 'createdAt'
        ])
        && data.keys().hasAll([
          'ownerId', 'owner', 'title', 'author', 'images', 'thumbnail',
          'category', 'type', 'available', 'bookCondition', 'createdAt'
        ])
        && data.ownerId == request.auth.uid
        && validText(data.owner) && data.owner.size() > 0
        && validText(data.title) && data.title.size() > 0
        && validText(data.author) && data.author.size() > 0
        && data.images is list && data.images.size() > 0
        && data.thumbnail is string && data.thumbnail.size() > 0
        && data.category is list
        && data.type in ['donation', 'exchange', 'pagination']
        && data.available is bool
        && data.bookCondition in ['new', 'like_new', 'good', 'worn']
        && (!('bookConditionNote' in data)
          || (data.bookConditionNote is string && data.bookConditionNote.size() <= 300))
        && (!('tradeWithBookId' in data)
          || (data.tradeWithBookId is string && data.tradeWithBookId.size() <= 120))
        && data.createdAt == request.time;
    }

    function validTradeBook(book) {
      return book is map
        && book.keys().hasOnly(['id', 'title', 'author', 'thumbnail'])
        && book.keys().hasAll(['id', 'title', 'author', 'thumbnail'])
        && validText(book.id) && book.id.size() > 0
        && validText(book.title) && book.title.size() > 0
        && validText(book.author) && book.author.size() > 0
        && book.thumbnail is string && book.thumbnail.size() <= 2000;
    }

    function validTradeBooks(books) {
      return books is list && books.size() >= 1 && books.size() <= 20
        && (books.size() < 1 || validTradeBook(books[0]))
        && (books.size() < 2 || validTradeBook(books[1]))
        && (books.size() < 3 || validTradeBook(books[2]))
        && (books.size() < 4 || validTradeBook(books[3]))
        && (books.size() < 5 || validTradeBook(books[4]))
        && (books.size() < 6 || validTradeBook(books[5]))
        && (books.size() < 7 || validTradeBook(books[6]))
        && (books.size() < 8 || validTradeBook(books[7]))
        && (books.size() < 9 || validTradeBook(books[8]))
        && (books.size() < 10 || validTradeBook(books[9]))
        && (books.size() < 11 || validTradeBook(books[10]))
        && (books.size() < 12 || validTradeBook(books[11]))
        && (books.size() < 13 || validTradeBook(books[12]))
        && (books.size() < 14 || validTradeBook(books[13]))
        && (books.size() < 15 || validTradeBook(books[14]))
        && (books.size() < 16 || validTradeBook(books[15]))
        && (books.size() < 17 || validTradeBook(books[16]))
        && (books.size() < 18 || validTradeBook(books[17]))
        && (books.size() < 19 || validTradeBook(books[18]))
        && (books.size() < 20 || validTradeBook(books[19]));
    }

    function validTrade(data) {
      return data.keys().hasOnly([
          'participantIds', 'sender', 'recipient', 'offeredBooks',
          'requestedBook', 'status', 'createdAt'
        ])
        && data.keys().hasAll([
          'participantIds', 'sender', 'recipient', 'offeredBooks',
          'requestedBook', 'status', 'createdAt'
        ])
        && data.participantIds is list && data.participantIds.size() == 2
        && data.sender is map && data.recipient is map
        && data.sender.keys().hasOnly(['uid', 'displayName'])
        && data.sender.keys().hasAll(['uid', 'displayName'])
        && data.recipient.keys().hasOnly(['uid', 'displayName'])
        && data.recipient.keys().hasAll(['uid', 'displayName'])
        && data.sender.uid == request.auth.uid
        && data.recipient.uid is string && data.recipient.uid != request.auth.uid
        && data.participantIds[0] == data.sender.uid
        && data.participantIds[1] == data.recipient.uid
        && validText(data.sender.displayName) && data.sender.displayName.size() > 0
        && validText(data.recipient.displayName) && data.recipient.displayName.size() > 0
        && validTradeBooks(data.offeredBooks)
        && validTradeBook(data.requestedBook)
        && data.status == 'pending'
        && data.createdAt == request.time;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'whatsapp', 'address', 'coordinates', 'books', 'likedBooks', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'email', 'whatsapp', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && validProfile(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'whatsapp', 'address', 'coordinates', 'books', 'likedBooks'])
        && validProfile(request.resource.data);
      allow delete: if false;
    }

    match /books/{bookId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && validBook(request.resource.data);
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    match /trades/{tradeId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null && validTrade(request.resource.data);
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'pending'
        && ((request.auth.uid == resource.data.sender.uid
            && request.resource.data.status == 'cancelled')
          || (request.auth.uid == resource.data.recipient.uid
            && request.resource.data.status == 'rejected'));
      allow delete: if false;
    }
  }
}
